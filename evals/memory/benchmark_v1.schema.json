{
  "$defs": {
    "BenchmarkExpected": {
      "additionalProperties": false,
      "properties": {
        "stage1": {
          "$ref": "#/$defs/Stage1Expectation"
        },
        "stage2": {
          "$ref": "#/$defs/Stage2Expectation"
        },
        "operation": {
          "enum": [
            "CREATE",
            "ENRICH",
            "REFINE",
            "UPDATE",
            "MERGE",
            "PROJECT",
            "PRESERVE",
            "NOOP",
            "MIXED"
          ],
          "title": "Operation",
          "type": "string"
        },
        "sub_operations": {
          "items": {
            "$ref": "#/$defs/OperationStep"
          },
          "minItems": 1,
          "title": "Sub Operations",
          "type": "array"
        }
      },
      "required": [
        "stage1",
        "stage2",
        "operation",
        "sub_operations"
      ],
      "title": "BenchmarkExpected",
      "type": "object"
    },
    "ConversationTurn": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "pattern": "^t[1-9]\\d*$",
          "title": "Turn Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "role",
        "content"
      ],
      "title": "ConversationTurn",
      "type": "object"
    },
    "FieldExpectation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "path",
        "alternatives"
      ],
      "title": "FieldExpectation",
      "type": "object"
    },
    "MemoryKind": {
      "enum": [
        "stable_fact",
        "preference",
        "interaction_event",
        "interaction_pattern",
        "advice_outcome",
        "planned_event",
        "action_intent",
        "relationship_state",
        "interaction_event",
        "interaction_pattern",
        "planned_event",
        "action_intent"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "OperationStep": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "CREATE",
            "ENRICH",
            "REFINE",
            "UPDATE",
            "MERGE",
            "PROJECT",
            "PRESERVE",
            "NOOP"
          ],
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetExpectation"
        },
        "claim_refs": {
          "items": {
            "type": "string"
          },
          "title": "Claim Refs",
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldExpectation"
          },
          "title": "Fields",
          "type": "array"
        },
        "output_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Dimension"
        },
        "output_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Value"
        },
        "minimum_evidence": {
          "default": 0,
          "minimum": 0,
          "title": "Minimum Evidence",
          "type": "integer"
        },
        "forbidden_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "turn_id",
        "operation"
      ],
      "title": "OperationStep",
      "type": "object"
    },
    "SemanticRole": {
      "description": "Semantic role produced by coarse extraction.\n\nThese values describe meaning only.  They are deliberately not database\nmutation commands; relation/lifecycle governance remains the authority for\nwrites.",
      "enum": [
        "new_proposition",
        "attribute_completion",
        "refinement",
        "correction",
        "uncertain",
        "state_update",
        "pattern_extraction",
        "belief_extraction",
        "contextual_completion",
        "standalone_proposition",
        "attribute_update",
        "refinement_candidate",
        "state_assertion"
      ],
      "title": "SemanticRole",
      "type": "string"
    },
    "SemanticUnitExpectation": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "evidence_span": {
          "minLength": 1,
          "title": "Evidence Span",
          "type": "string"
        },
        "semantic_role": {
          "$ref": "#/$defs/SemanticRole"
        }
      },
      "required": [
        "turn_id",
        "evidence_span",
        "semantic_role"
      ],
      "title": "SemanticUnitExpectation",
      "type": "object"
    },
    "Stage1Expectation": {
      "additionalProperties": false,
      "properties": {
        "should_extract": {
          "title": "Should Extract",
          "type": "boolean"
        },
        "semantic_units": {
          "items": {
            "$ref": "#/$defs/SemanticUnitExpectation"
          },
          "title": "Semantic Units",
          "type": "array"
        },
        "negative_turn_ids": {
          "items": {
            "type": "string"
          },
          "title": "Negative Turn Ids",
          "type": "array"
        }
      },
      "required": [
        "should_extract"
      ],
      "title": "Stage1Expectation",
      "type": "object"
    },
    "Stage2ClaimExpectation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^c[1-9]\\d*$",
          "title": "Claim Id",
          "type": "string"
        },
        "source_turn_id": {
          "title": "Source Turn Id",
          "type": "string"
        },
        "semantic_type": {
          "default": "new_memory",
          "enum": [
            "new_memory",
            "enrichment",
            "refinement"
          ],
          "title": "Semantic Type",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "predicate_policy": {
          "default": "semantic",
          "enum": [
            "canonical",
            "semantic",
            "custom"
          ],
          "title": "Predicate Policy",
          "type": "string"
        },
        "event_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type"
        },
        "perspective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perspective"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "semantic_target": {
          "title": "Semantic Target",
          "type": "string"
        },
        "evidence_spans": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Spans",
          "type": "array"
        },
        "value_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Value Groups",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "source_turn_id",
        "kind",
        "subject",
        "predicate",
        "semantic_target",
        "evidence_spans",
        "value_groups"
      ],
      "title": "Stage2ClaimExpectation",
      "type": "object"
    },
    "Stage2Expectation": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/Stage2ClaimExpectation"
          },
          "title": "Claims",
          "type": "array"
        }
      },
      "title": "Stage2Expectation",
      "type": "object"
    },
    "TargetExpectation": {
      "additionalProperties": false,
      "properties": {
        "selector": {
          "default": "none",
          "enum": [
            "none",
            "unique_matching",
            "event_sequence"
          ],
          "title": "Selector",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "title": "TargetExpectation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^BM-\\d{3}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "memory-benchmark-v1",
      "default": "memory-benchmark-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "category": {
      "enum": [
        "stable_fact",
        "preference",
        "event",
        "enrichment",
        "pattern",
        "state",
        "long_tail"
      ],
      "title": "Category",
      "type": "string"
    },
    "scenario": {
      "minLength": 1,
      "title": "Scenario",
      "type": "string"
    },
    "failure_mode": {
      "minLength": 1,
      "title": "Failure Mode",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "length_class": {
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "title": "Length Class",
      "type": "string"
    },
    "conversation": {
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "maxItems": 60,
      "minItems": 1,
      "title": "Conversation",
      "type": "array"
    },
    "expected": {
      "$ref": "#/$defs/BenchmarkExpected"
    },
    "review_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Reason"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "id",
    "category",
    "scenario",
    "failure_mode",
    "difficulty",
    "length_class",
    "conversation",
    "expected"
  ],
  "title": "MemoryBenchmarkCase",
  "type": "object"
}
