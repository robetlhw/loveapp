LOVEAPP_ENVIRONMENT=development
LOVEAPP_LOG_LEVEL=INFO
LOVEAPP_KNOWLEDGE_PATH=knowledge

# ==========================================
# DeepSeek shared provider
# ==========================================
LOVEAPP_LLM_PROVIDER=deepseek
LOVEAPP_LLM_API_KEY=
LOVEAPP_LLM_BASE_URL=https://api.deepseek.com


# ==========================================
# Main generation / relationship advice
# ==========================================
LOVEAPP_LLM_MODEL=deepseek-v4-pro
LOVEAPP_LLM_MAX_TOKENS=4096
LOVEAPP_ADVICE_MODEL=deepseek-v4-pro
LOVEAPP_ADVICE_MAX_TOKENS=4096
LOVEAPP_ADVICE_THINKING=disabled
LOVEAPP_ADVICE_TEMPERATURE=0
LOVEAPP_ADVICE_STRUCTURED_RETRIES=1


# ==========================================
# Router
# ==========================================
LOVEAPP_ROUTER_PROVIDER=llm
LOVEAPP_ROUTER_MODEL=deepseek-v4-flash
LOVEAPP_ROUTER_MAX_TOKENS=2048
LOVEAPP_ROUTER_TIMEOUT_SECONDS=20
LOVEAPP_ROUTER_MAX_RETRIES=0
LOVEAPP_ROUTER_THINKING=disabled
LOVEAPP_ROUTER_V2_ENABLED=false
LOVEAPP_ROUTER_SEMANTIC_MODE=legacy
LOVEAPP_ROUTER_LLM_CORRECTION_ENABLED=false
LOVEAPP_ROUTER_LLM_ALWAYS_ON_FOR_RELATIONSHIP=false
LOVEAPP_ROUTER_LLM_LOW_CONFIDENCE_THRESHOLD=0.72
LOVEAPP_ROUTER_LLM_MARGIN_THRESHOLD=0.16
LOVEAPP_ROUTER_GOAL_SECONDARY_THRESHOLD=0.3
LOVEAPP_ROUTER_GOAL_MAX_COUNT=3
LOVEAPP_ROUTER_CONDITIONAL_TRIGGER_PROFILE=c2
# Phase 3.2 live semantic-router aliases/controls
LOVEAPP_ROUTER_LLM_PROVIDER=deepseek
LOVEAPP_ROUTER_LLM_MODEL=deepseek-v4-flash
LOVEAPP_ROUTER_LLM_TEMPERATURE=0
LOVEAPP_ROUTER_LLM_MAX_TOKENS=2048
LOVEAPP_ROUTER_LLM_TIMEOUT_SECONDS=20
LOVEAPP_ROUTER_LLM_MAX_RETRIES=1
LOVEAPP_ROUTER_LLM_STRUCTURED_OUTPUT=json_schema
LOVEAPP_ROUTER_LLM_PROMPT_VERSION=routing-v3.2-v1
# Explicit safety gate for commands that make paid live evaluation calls.
LOVEAPP_ROUTER_LIVE_EVAL_ENABLED=false
LOVEAPP_CONTEXTUAL_QUERY_REWRITE_ENABLED=false
LOVEAPP_QUERY_DECOMPOSITION_ENABLED=false
LOVEAPP_MAX_SUBQUERIES=3
LOVEAPP_CONTEXTUAL_REWRITE_HISTORY_WINDOW=4


# ==========================================
# DatePlan semantic interpretation
# ==========================================
LOVEAPP_DATE_SEMANTIC_PROVIDER=llm
LOVEAPP_DATE_SEMANTIC_MODEL=deepseek-v4-flash
LOVEAPP_DATE_SEMANTIC_MAX_TOKENS=2048
LOVEAPP_DATE_SEMANTIC_TIMEOUT_SECONDS=20
LOVEAPP_DATE_SEMANTIC_MAX_RETRIES=0
LOVEAPP_DATE_SEMANTIC_THINKING=disabled
LOVEAPP_DATE_SEMANTIC_PROMPT_VERSION=date-semantic-v1.0


# ==========================================
# Memory extraction
# ==========================================
LOVEAPP_MEMORY_EXTRACTION_PROVIDER=llm
LOVEAPP_MEMORY_EXTRACTION_MODE=single_stage
LOVEAPP_MEMORY_EXTRACTION_MODEL=deepseek-v4-flash
LOVEAPP_MEMORY_EXTRACTION_MAX_TOKENS=1536
LOVEAPP_MEMORY_EXTRACTION_TIMEOUT_SECONDS=30
LOVEAPP_MEMORY_EXTRACTION_MAX_RETRIES=0
LOVEAPP_MEMORY_EXTRACTION_THINKING=disabled

# Optional synthetic-evaluation tracing. Never put a real key in this file.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=loveapp-memory-evals
LANGSMITH_WORKSPACE_ID=


# ==========================================
# RAG
# ==========================================
LOVEAPP_RAG_MIN_SCORE=0.45
LOVEAPP_RAG_CANDIDATE_LIMIT=15
LOVEAPP_RAG_RERANKER_MODE=full
LOVEAPP_RAG_LEXICAL_WEIGHT=1.0
LOVEAPP_RAG_METADATA_WEIGHT=1.0
LOVEAPP_RAG_RETRIEVAL_TEXT_MODE=full
LOVEAPP_RAG_HARD_FILTER=false
LOVEAPP_QDRANT_URL=http://localhost:6333
LOVEAPP_QDRANT_COLLECTION=love_knowledge


# ==========================================
# Map
# ==========================================
LOVEAPP_AMAP_API_KEY=
