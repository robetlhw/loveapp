LOVEAPP_ENVIRONMENT=development
LOVEAPP_LOG_LEVEL=INFO
LOVEAPP_KNOWLEDGE_PATH=knowledge

# Model used to compose the final grounded response.
LOVEAPP_LLM_PROVIDER=deepseek
LOVEAPP_LLM_MODEL=deepseek-v4-pro
LOVEAPP_LLM_API_KEY=
LOVEAPP_LLM_BASE_URL=https://api.deepseek.com
LOVEAPP_LLM_TIMEOUT_SECONDS=120
LOVEAPP_LLM_MAX_RETRIES=2
LOVEAPP_LLM_MAX_TOKENS=4096

# Hybrid task/goal/scenario router. A small non-thinking model is recommended;
# leave the model empty to reuse LOVEAPP_LLM_MODEL.
LOVEAPP_ROUTER_PROVIDER=auto
LOVEAPP_ROUTER_MODEL=
LOVEAPP_ROUTER_MAX_TOKENS=2048
LOVEAPP_ROUTER_TIMEOUT_SECONDS=20
LOVEAPP_ROUTER_MAX_RETRIES=0
LOVEAPP_ROUTER_THINKING=disabled
LOVEAPP_ROUTER_CONFIDENCE_THRESHOLD=0.72
LOVEAPP_ROUTER_AMBIGUITY_MARGIN=0.16

# RAG and local embedding settings.
LOVEAPP_RAG_BACKEND=qdrant
LOVEAPP_RAG_MIN_SCORE=0.45
LOVEAPP_QDRANT_URL=http://localhost:6333
LOVEAPP_QDRANT_COLLECTION=love_knowledge
LOVEAPP_QDRANT_TIMEOUT_SECONDS=20
LOVEAPP_EMBEDDING_PROVIDER=sentence_transformers
LOVEAPP_EMBEDDING_SOURCE=modelscope
LOVEAPP_EMBEDDING_MODEL=AI-ModelScope/bge-small-zh-v1.5
LOVEAPP_EMBEDDING_DEVICE=cpu
LOVEAPP_EMBEDDING_BATCH_SIZE=16
LOVEAPP_EMBEDDING_CACHE_PATH=.cache/modelscope

# Persistent relationship memory. Leave the extraction model empty to reuse LOVEAPP_LLM_MODEL.
# A dedicated low-latency structured-output model can be configured independently after evaluation.
LOVEAPP_MEMORY_BACKEND=sqlite
LOVEAPP_MEMORY_DATABASE_PATH=.data/loveapp.db
LOVEAPP_MEMORY_EXTRACTION_PROVIDER=auto
LOVEAPP_MEMORY_EXTRACTION_MODEL=deepseek-v4-flash
LOVEAPP_MEMORY_EXTRACTION_TIMEOUT_SECONDS=30
LOVEAPP_MEMORY_EXTRACTION_MAX_RETRIES=0
LOVEAPP_MEMORY_EXTRACTION_MAX_TOKENS=1536
LOVEAPP_MEMORY_EXTRACTION_THINKING=disabled
# Optional strong fallback. Empty means reuse LOVEAPP_LLM_MODEL (for example deepseek-v4-pro).
LOVEAPP_MEMORY_EXTRACTION_STRONG_MODEL=
LOVEAPP_MEMORY_EXTRACTION_STRONG_TIMEOUT_SECONDS=60
LOVEAPP_MEMORY_EXTRACTION_STRONG_MAX_RETRIES=1
LOVEAPP_MEMORY_EXTRACTION_STRONG_MAX_TOKENS=4096
LOVEAPP_MEMORY_EXTRACTION_STRONG_THINKING=enabled
LOVEAPP_MEMORY_EXTRACTION_UPGRADE_MIN_IMPORTANCE=4
LOVEAPP_MEMORY_MIN_CONFIDENCE=0.65
# Tentative user beliefs and hearsay can be retained as proposed memories.
LOVEAPP_MEMORY_TENTATIVE_MIN_CONFIDENCE=0.5
LOVEAPP_MEMORY_BELIEF_MIN_CONFIDENCE=0.4
LOVEAPP_MEMORY_CONTEXT_LIMIT=20
LOVEAPP_CONVERSATION_HISTORY_LIMIT=12
LOVEAPP_MEMORY_CONTEXT_WAIT_SECONDS=2
LOVEAPP_MEMORY_SHUTDOWN_GRACE_SECONDS=10

# Map and POI provider.
LOVEAPP_MAP_PROVIDER=amap
LOVEAPP_AMAP_API_KEY=
LOVEAPP_AMAP_BASE_URL=https://restapi.amap.com
LOVEAPP_AMAP_TIMEOUT_SECONDS=20
LOVEAPP_AMAP_PAGE_SIZE=25
LOVEAPP_AMAP_MIN_INTERVAL_SECONDS=0.6
LOVEAPP_AMAP_MAX_RETRIES=2
# Optional weather-aware ranking. `amap` only queries when a date is known.
LOVEAPP_WEATHER_PROVIDER=disabled
LOVEAPP_WEATHER_TIMEOUT_SECONDS=20
